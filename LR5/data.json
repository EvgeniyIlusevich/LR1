": "polotsk"}}, {"model": "OnlineShop.sale", "pk": 30, "fields": {"customer": 10, "sale_date": "2026-05-21T12:14:50.826Z", "delivery_date": "2026-05-28T12:14:50.826Z", "total_price": "7.00", "city": "Pinsk"}}, {"model": "OnlineShop.saleproduct", "pk": 19, "fields": {"sale": 25, "product": 24, "quantity": 10, "price": "1.79"}}, {"model": "OnlineShop.saleproduct", "pk": 20, "fields": {"sale": 26, "product": 24, "quantity": 10, "price": "0.02"}}, {"model": "OnlineShop.saleproduct", "pk": 21, "fields": {"sale": 27, "product": 25, "quantity": 10, "price": "9.99"}}, {"model": "OnlineShop.saleproduct", "pk": 22, "fields": {"sale": 28, "product": 28, "quantity": 10, "price": "4.99"}}, {"model": "OnlineShop.saleproduct", "pk": 23, "fields": {"sale": 29, "product": 33, "quantity": 10, "price": "1.00"}}, {"model": "OnlineShop.saleproduct", "pk": 24, "fields": {"sale": 30, "product": 27, "quantity": 7, "price": "1.00"}}, {"model": "OnlineShop.article", "pk": 12, "fields": {"title": "100 по цене 1", "publication_date": "2026-05-18", "summary": "РАСПРОДАЖА", "content": "УСПЕЙ НЕ КУПИТЬ", "author": "adnim", "image": "images/images_xBTjkGg.jpeg"}}, {"model": "OnlineShop.article", "pk": 13, "fields": {"title": "99% скидка", "publication_date": "2026-05-19", "summary": "Распродажа", "content": "Зевни", "author": "manager", "image": "images/images.png"}}, {"model": "OnlineShop.article", "pk": 14, "fields": {"title": "Покупаете вы - платим мы", "publication_date": "2026-05-13", "summary": "Акция", "content": "Пропусти", "author": "manager", "image": "images/images_xbSwZna.jpeg"}}, {"model": "OnlineShop.faq", "pk": 11, "fields": {"question": "А это средство правда убивает 99.9% всех бактерий?", "answer": "Правда. А ещё оно убивает 0.1% твоей надежды на то, что можно не убираться. Но мы молчим об этом.", "date_added": "2026-05-21T09:08:13.555Z"}}, {"model": "OnlineShop.faq", "pk": 12, "fields": {"question": "Можно ли мыть посуду средством для унитаза? (просто оно дешевле)", "answer": "Можно. Но потом мыть желудок будет стоить дороже. Экономьте с умом: купите лучше наше средство «Просто посуда, не унитаз».", "date_added": "2026-05-21T09:09:16.832Z"}}, {"model": "OnlineShop.faq", "pk": 13, "fields": {"question": "Почему у вас такой странный запах у порошка — «утренняя свежесть с нотками химического завода»?", "answer": "Это фирменный аромат «Я проспал, но постирать успел». Мы не при чём — так пахнет чистота без выходных.", "date_added": "2026-05-21T09:09:47.731Z"}}, {"model": "OnlineShop.faq", "pk": 14, "fields": {"question": "А можно попробовать средство на месте? Ну, капнуть на рукав?", "answer": "Можно. Но предупреждаем: если ваш рукав растворится вместе с пятном, мы выдадим вам новую упаковку с наклейкой «Герой лабораторных испытаний».", "date_added": "2026-05-21T09:10:14.739Z"}}, {"model": "OnlineShop.faq", "pk": 15, "fields": {"question": "Почему у вас на ценнике написано «Цена: как новый год — долго ждать, но быстро пролетает ?", "answer": "Потому что это акция. Вы моргнёте — а скидка уже закончилась. Но средство осталось с вами навсегда (или до следующей стирки)", "date_added": "2026-05-21T09:11:32.368Z"}}, {"model": "OnlineShop.employee", "pk": 11, "fields": {"name": "Добрыня", "photo": "images/images.jpeg", "job_description": "Хранитель зелья мыльного и порошка стирального", "phone": "+375 29 101-11-11", "email": "dobrynya@mylodvar.by"}}, {"model": "OnlineShop.employee", "pk": 12, "fields": {"name": "Любава", "photo": "images/images_78K63yu.jpeg", "job_description": "Ворожея над пятнами неведомыми", "phone": "+375 29 303-33-33", "email": "lubava@pyatno.by"}}, {"model": "OnlineShop.employee", "pk": 13, "fields": {"name": "Радимир", "photo": "images/bhqvnjgklwtxfs1i2sxbsuln78ffsj10.png", "job_description": "Зрячий очей микрофибры (ищет пропавшие тряпки)", "phone": "+375 29 606-66-66", "email": "radimir@teryayka.by"}}, {"model": "OnlineShop.employee", "pk": 14, "fields": {"name": "Болеслава", "photo": "images/images_9RErow8.jpeg", "job_description": "Блюстительница сроков годности (даже тех, что истекли)", "phone": "+375 29 707-77-77", "email": "boleslava@srok.by"}}, {"model": "OnlineShop.employee", "pk": 15, "fields": {"name": "Гостомысл", "photo": "images/images_5muloCf.jpeg", "job_description": "Ведун совместимости уксуса с содой (категорически запрещает)", "phone": "+375 29 808-88-88", "email": "gostomysl@ne-meshay.by"}}, {"model": "OnlineShop.employee", "pk": 16, "fields": {"name": "Милолика", "photo": "images/images_IwwhVXU.jpeg", "job_description": "Ладница по ароматам «утренней свежести» и «хвойного леса»", "phone": "+375 29 909-99-99", "email": "milolika@pachnet.by"}}, {"model": "OnlineShop.promocode", "pk": 11, "fields": {"code": "PIKOCHY", "discount_percent": 10, "active": true}}, {"model": "OnlineShop.promocode", "pk": 12, "fields": {"code": "SOROCHINO", "discount_percent": 99, "active": true}}, {"model": "OnlineShop.promocode", "pk": 13, "fields": {"code": "777", "discount_percent": 77, "active": true}}, {"model": "OnlineShop.promocode", "pk": 14, "fields": {"code": "NEPROMOCODE", "discount_percent": 50, "active": false}}, {"model": "OnlineShop.vacancy", "pk": 4, "fields": {"title": "Python developer (senior-pomidor)", "description": "Мы ищем тебя, если ты:\r\n\r\n    Готов работать руками — не только клавиши нажимать, но и посты пальцем тыкать, видео кнопкой «экспорт» монтировать.\r\n\r\n    Креативен настолько, что даже stackoverflow не нужен. Нестандартные решения — твой код оборачивается в мемы.\r\n\r\n    Имеешь навыки работы с социальными сетями — например, знаешь, как запостить ссылку на свой GitHub, чтобы её залайкал дядя из отдела маркетинга.\r\n\r\nТвои обязанности (да, серьёзно, мы их переписали под Python’а):\r\n\r\n    Работа с блогерами — поиск тех, кто готов пиарить твой парсер. Переговоры в духе «слайсинг срезами» и закупка рекламы за донаты на кофе.\r\n\r\n    Анализировать статистику — но не как все, а через pandas и с приколом. Предлагать улучшения, например: «Давайте просто перепишем всё на Rust».", "salary": "15000.00", "published_date": "2026-05-21"}}, {"model": "OnlineShop.vacancy", "pk": 5, "fields": {"title": "Продавец-консультант в отдел «Всё для чистоты»", "description": "Чем предстоит заниматься:\r\n\r\n    Консультировать покупателей с таким видом, будто вы знаете формулу любого пятновыводителя. Даже если ответ — «я сам не понимаю, почему этот шампунь пахнет огурцом и бензином одновременно».\r\n\r\n    Рассказывать про отличия средства для стекол от средства для унитаза — это важно, потому что некоторые клиенты путают. Серьёзно. Случалось.\r\n\r\n    Открывать коробки с «Мистером Пропером» и не чихать при этом. Если чихаешь — делай вид, что это фирменный звук акции.\r\n\r\nМы ожидаем:\r\n\r\n    Иммунитет к рекламным слоганам — чтобы фраза «с первого раза без разводов» не вызывала неконтролируемый смех.\r\n\r\n    Способность различать 15 оттенков белого (на этикетках — не на стенах).\r\n\r\n    Отсутствие аллергии на запах «морской бриз, утро, озон и лимонная цедра в одном флаконе».", "salary": null, "published_date": "2026-05-21"}}, {"model": "OnlineShop.vacancy", "pk": 6, "fields": {"title": "инженер по тестированию чистящих средств (он же «лаборант-практикант с тряпкой»)", "description": "Чем предстоит заниматься:\r\n\r\n    Тестировать новые средства для душа на собственной плитке в подсобке. Говорят, она стала чище, но всё так же пахнет ядрёным гелем для унитаза (это не баг, это фича).\r\n\r\n    Выводить пятна с разной поверхности: кетчуп с футболки, жир с вытяжки, следы от фломастера на столе директора. Последнее — необязательно, но если хочешь премию…\r\n\r\nМы ожидаем:\r\n\r\n    Любовь к грязи ради науки — и к тому, как с ней бороться.\r\n\r\n    Умение не нюхать содержимое бутылочек с надписью «Опасно» (это даже не шутка, а техника безопасности).", "salary": "500.00", "published_date": "2026-05-21"}}]